{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates (see the deps.edn of an already-fixed sibling,
 ;; e.g. cloud-itonami-isic-869 / cloud-itonami-isic-1074, which pin
 ;; langgraph via :git/sha for exactly this reason).
 ;;
 ;; PRIOR BUG (fixed here, same compounding class as sibling actors): this
 ;; dependency previously existed ONLY under the `:dev` alias's
 ;; `:override-deps`, with the base `:deps` map EMPTY. `:override-deps`
 ;; only overrides a coordinate for a library ALREADY present somewhere in
 ;; the resolved dependency graph -- with no base `:deps` entry for
 ;; `io.github.kotoba-lang/langgraph` there was nothing to override, so
 ;; `langgraph.graph` was never actually resolvable on ANY alias
 ;; combination, including the ones this file itself declares as the
 ;; run/test path (`:run`, `:test`, `:dev:test`). That is the direct cause
 ;; of `huntharvest.operation` never having been able to
 ;; `:require [langgraph.graph]` in the first place, and of
 ;; `huntharvest.advisor` being a docstring-only skeleton with zero
 ;; functions -- there was nothing for it to be wired into.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "huntharvest.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by running the REAL actor
  ;; (flagship checklist item 2). Deliberately NO extra dependency: the
  ;; console's stylesheet is read out of the design-system copy already
  ;; vendored into docs/index.html (see `huntharvest.render-html`), so
  ;; regenerating the page needs nothing this repo does not already
  ;; contain and works with no network access at all.
  :render-html {:main-opts ["-m" "huntharvest.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
